{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Patch Pilot",
  "version": "0.1.0",
  "identifier": "com.patchpilot.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Patch Pilot",
        "width": 1040,
        "height": 680,
        "minWidth": 760,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNCNURBQzA2MEREMjREQjQKUldTMFRkSU5CcXhkTzFsMEwwd2JIMWF6eXNVcDQrSnAzRWFQcC9FWGd6a2J5YS9IbDhhM0tvbUcK",
      "endpoints": [
        "https://github.com/PatchPilotSync/patch-pilot-releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
