{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Patch Pilot",
  "version": "0.1.0",
  "identifier": "com.patchpilot.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Patch Pilot",
        "width": 1040,
        "height": 680,
        "minWidth": 760,
        "minHeight": 480
      },
      {
        "label": "tray",
        "title": "Patch Pilot",
        "width": 340,
        "height": 460,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
