{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Patch Pilot",
  "version": "0.4.42",
  "identifier": "com.patchpilot.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Patch Pilot",
        "width": 1040,
        "height": 680,
        "minWidth": 760,
        "minHeight": 480,
        "visible": false,
        "acceptFirstMouse": true
      },
      {
        "label": "tray",
        "title": "Patch Pilot",
        "width": 340,
        "height": 460,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI5M0FFQzg4NTk5QURGNUEKUldSYTM1cFppT3c2S2U2dWlodnhWcTRTL0FtZmRkazAzUlBBay9ZYWx4LzR1YVJSRW8rVUM0K0oK",
      "endpoints": [
        "https://github.com/PatchPilotSync/patch-pilot-releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
